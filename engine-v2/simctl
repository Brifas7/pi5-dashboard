#!/bin/bash
# simctl start|stop|on|off|send <cmd>|watch [secs]|log
P=~/.config/dashboard/devices.pass
T=dashboard/lights/front_door_flood
case "$1" in
  start) tmux kill-session -t sim 2>/dev/null
         tmux new -d -s sim "SIM_PASS=\$(cat $P) python3 ~/engine-v2/sim_light.py; echo '[sim exited]'; sleep 3600"
         sleep 2; tmux capture-pane -pt sim | grep -v '^$' | tail -3 ;;
  stop)  tmux send-keys -t sim quit Enter; sleep 1; echo stopped ;;
  send)  tmux send-keys -t sim "$2" Enter; sleep 1
         tmux capture-pane -pt sim | grep -v '^$' | tail -3 ;;
  on|off) mosquitto_sub -h localhost -t "$T/#" -v -W 4 & sleep 1
         mosquitto_pub -h localhost -q 1 -t "$T/set" -m "{\"v\":1,\"state\":\"$1\",\"source\":\"test\"}"; wait ;;
  watch) mosquitto_sub -h localhost -t 'dashboard/lights/#' -v -W "${2:-5}" ;;
  log)   tmux capture-pane -pt sim | grep -v '^$' | tail -"${2:-10}" ;;
  *)     echo "usage: simctl start|stop|on|off|send <silent|deadbulb|normal|switch|drop>|watch [secs]|log" ;;
esac
