#!/bin/bash
# engctl start|stop|log [lines]|testrule|testsun|testmix|testgroup
# start/stop run the engine in tmux for testing. Refuses while the engine-v2 service is running.
case "$1" in
  start) if systemctl is-active --quiet engine-v2; then echo "engine-v2 service is running; stop it first: sudo systemctl stop engine-v2"; exit 1; fi
         tmux kill-session -t engine 2>/dev/null
         tmux new -d -s engine "python3 -u ~/engine-v2/engine.py 2>&1 | tee -a ~/engine-v2/engine.log; sleep 3600"
         sleep 4; tail -5 ~/engine-v2/engine.log ;;
  stop)  tmux kill-session -t engine 2>/dev/null; echo stopped ;;
  log)   tail -"${2:-15}" ~/engine-v2/engine.log ;;
  testrule)  python3 ~/engine-v2/mkrule.py clock ;;
  testsun)   python3 ~/engine-v2/mkrule.py sun ;;
  testmix)   python3 ~/engine-v2/mkrule.py mix ;;
  testgroup) python3 ~/engine-v2/mkrule.py group ;;
  *)     echo "usage: engctl start|stop|log [lines]|testrule|testsun|testmix|testgroup" ;;
esac
